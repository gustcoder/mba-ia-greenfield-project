# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Object storage (MinIO, local S3-compatible server)
MINIO_ROOT_USER=streamtube
MINIO_ROOT_PASSWORD=streamtube-secret

# Object storage client (S3-compatible; MinIO in dev). Hosts are Compose service names.
# S3_PUBLIC_ENDPOINT is the host baked into presigned URLs; it stays the service name in dev/test.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=streamtube
S3_SECRET_KEY=streamtube-secret
S3_BUCKET=streamtube-videos
S3_FORCE_PATH_STYLE=true

# Queue (BullMQ on Redis)
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_PREFIX=bull

# Videos
VIDEO_MAX_SIZE_BYTES=10737418240
VIDEO_UPLOAD_PART_SIZE_BYTES=104857600
VIDEO_UPLOAD_URL_TTL_SECONDS=3600
VIDEO_PLAYBACK_URL_TTL_SECONDS=3600
VIDEO_SOURCE_URL_TTL_SECONDS=21600
VIDEO_PROCESSING_ATTEMPTS=3
VIDEO_PROCESSING_BACKOFF_MS=10000
