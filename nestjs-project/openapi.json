            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestartVideoUploadDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Video back to draft with a new upload session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoUploadResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (VALIDATION_ERROR) or file above the size limit (VIDEO_TOO_LARGE)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found or not owned by the user (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video did not fail with an expired upload (INVALID_UPLOAD_STATE)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Restart an expired upload",
        "tags": [
          "videos"
        ]
      }
    },
