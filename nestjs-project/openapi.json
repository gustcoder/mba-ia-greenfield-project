    "/videos": {
      "post": {
        "description": "Pre-registers the video as a draft in the authenticated user channel and opens a multipart upload in the object storage. The client then signs the parts it needs and sends them straight to the storage.",
        "operationId": "VideosController_initiateUpload",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiateVideoUploadDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft created and multipart upload opened",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoUploadResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (VALIDATION_ERROR), unsupported MIME type (UNSUPPORTED_MEDIA_TYPE) or file above the size limit (VIDEO_TOO_LARGE)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Start a video upload",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{videoId}/upload/part-urls": {
      "post": {
        "description": "Signs, on demand, the presigned PUT urls for the requested part numbers of a draft video the user owns. The client sends each part straight to the object storage and keeps the ETag it returns.",
        "operationId": "VideosController_signParts",
        "parameters": [
          {
            "name": "videoId",
            "required": true,
            "in": "path",
            "description": "Public video id (11 chars)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUploadPartsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Presigned PUT urls and their expiry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedUploadPartsResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (VALIDATION_ERROR) or part number above the upload part count (INVALID_PART_NUMBER)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found or not owned by the user (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is not a draft (INVALID_UPLOAD_STATE)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "The multipart upload expired in the storage (UPLOAD_EXPIRED); the video becomes failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Sign upload part urls",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{videoId}/upload/parts": {
      "get": {
        "description": "Lists the parts the object storage already received for a draft video the user owns, so an interrupted upload can resume with only the missing parts.",
        "operationId": "VideosController_listParts",
        "parameters": [
          {
            "name": "videoId",
            "required": true,
            "in": "path",
            "description": "Public video id (11 chars)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Upload geometry and the parts already stored",
