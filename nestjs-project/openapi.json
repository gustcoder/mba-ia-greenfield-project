      "get": {
        "description": "Returns a presigned GET url of the video. The object storage serves it with Range support (206), so a player starts without downloading the whole file. Only ready videos.",
        "operationId": "VideosController_getStreamUrl",
        "parameters": [
          {
            "name": "videoId",
            "required": true,
            "in": "path",
            "description": "Public video id (11 chars)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Presigned streaming url and its expiry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresignedUrlResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found or not owned by the user (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is not ready yet (VIDEO_NOT_READY)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get the streaming url",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{videoId}/download": {
      "get": {
        "description": "Like the streaming url, but signed with Content-Disposition: attachment and the original file name, so the browser downloads the file. Only ready videos.",
        "operationId": "VideosController_getDownloadUrl",
        "parameters": [
          {
            "name": "videoId",
            "required": true,
            "in": "path",
            "description": "Public video id (11 chars)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Presigned download url and its expiry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresignedUrlResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found or not owned by the user (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is not ready yet (VIDEO_NOT_READY)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get the download url",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "InitiateVideoUploadDto": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "example": "aula.mp4",
            "maxLength": 255
          },
          "mime_type": {
            "type": "string",
            "enum": [
              "video/mp4",
              "video/quicktime",
              "video/webm",
              "video/x-matroska"
            ],
            "example": "video/mp4"
          },
          "size_bytes": {
            "type": "number",
            "example": 314572800,
            "minimum": 1
          },
          "title": {
            "type": "string",
            "example": "Minha aula",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "filename",
          "mime_type",
          "size_bytes"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "dQw4w9WgXcQ",
            "description": "Public video id (URL)."
          },
          "title": {
            "type": "string",
            "example": "aula"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "example": "draft"
          },
          "failure_reason": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "original_filename": {
            "type": "string",
            "example": "aula.mp4"
          },
          "mime_type": {
            "type": "string",
            "example": "video/mp4"
          },
          "size_bytes": {
            "type": "number",
            "example": 314572800
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true,
            "example": 12.5
          },
          "width": {
            "type": "number",
            "nullable": true,
            "example": 1280
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 720
          },
          "video_codec": {
            "type": "string",
            "nullable": true,
            "example": "h264"
          },
          "thumbnail_url": {
            "type": "string",
            "nullable": true,
            "description": "Presigned GET url of the thumbnail; null until processed."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "failure_reason",
          "original_filename",
          "mime_type",
          "size_bytes",
          "duration_seconds",
          "width",
          "height",
          "video_codec",
          "thumbnail_url",
          "created_at",
          "updated_at"
        ]
      },
      "UploadSessionDto": {
        "type": "object",
        "properties": {
          "part_size_bytes": {
            "type": "number",
            "example": 104857600
          },
          "part_count": {
            "type": "number",
            "example": 3
          }
        },
        "required": [
          "part_size_bytes",
          "part_count"
        ]
      },
      "VideoUploadResponseDto": {
        "type": "object",
        "properties": {
          "video": {
            "$ref": "#/components/schemas/VideoResponseDto"
          },
          "upload": {
            "$ref": "#/components/schemas/UploadSessionDto"
          }
        },
        "required": [
          "video",
          "upload"
        ]
      },
      "SignUploadPartsDto": {
        "type": "object",
        "properties": {
          "part_numbers": {
            "example": [
              1,
              2
            ],
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "part_numbers"
        ]
      },
      "SignedUploadPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned PUT url; send the part bytes straight to it."
          }
        },
        "required": [
          "part_number",
          "url"
        ]
      },
      "SignedUploadPartsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignedUploadPartDto"
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the urls expire."
          }
        },
        "required": [
          "parts",
          "expires_at"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "etag": {
            "type": "string",
            "example": "\"9bb58f26192e4ba00f01e2e7b136bbd8\""
          },
          "size_bytes": {
            "type": "number",
            "example": 104857600
          }
        },
        "required": [
          "part_number",
          "etag",
          "size_bytes"
        ]
      },
      "UploadedPartsResponseDto": {
        "type": "object",
        "properties": {
          "part_size_bytes": {
            "type": "number",
            "example": 104857600
          },
          "part_count": {
            "type": "number",
            "example": 3
          },
          "uploaded_parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "part_size_bytes",
          "part_count",
          "uploaded_parts"
        ]
      },
      "CompleteUploadPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1,
            "minimum": 1,
            "maximum": 10000
          },
          "etag": {
            "type": "string",
            "example": "\"9bb58f26192e4ba00f01e2e7b136bbd8\""
          }
        },
        "required": [
          "part_number",
          "etag"
        ]
      },
      "CompleteVideoUploadDto": {
        "type": "object",
        "properties": {
          "parts": {
            "minItems": 1,
            "maxItems": 10000,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompleteUploadPartDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "RestartVideoUploadDto": {
        "type": "object",
        "properties": {
          "size_bytes": {
            "type": "number",
            "example": 209715200,
            "minimum": 1
          }
        }
      },
      "PresignedUrlResponseDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Presigned GET url served by the object storage."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the url stops working."
          }
        },
        "required": [
          "url",
          "expires_at"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}